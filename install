#!/bin/bash
# Theme Installer & Linker for Nodaysidle Royal Red
set -euo pipefail

THEME_SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="$HOME/.config/omarchy/themes/nodaysidle-royal-red"
HOOK_DIR="$HOME/.config/omarchy/hooks/theme-set.d"

mkdir -p "$HOME/.config/omarchy/themes"
if [[ "$THEME_SRC" != "$TARGET_DIR" ]]; then
  rm -rf "$TARGET_DIR"
  ln -sfn "$THEME_SRC" "$TARGET_DIR"
  echo "✔ Linked theme: $THEME_SRC -> $TARGET_DIR"
fi

mkdir -p "$HOOK_DIR"
install -m 755 "$THEME_SRC/hooks/nodaysidle-royal-red" "$HOOK_DIR/nodaysidle-royal-red"
echo "✔ Hook installed: $HOOK_DIR/nodaysidle-royal-red"

echo "Ready! Apply anytime with: omarchy theme set nodaysidle-royal-red"
