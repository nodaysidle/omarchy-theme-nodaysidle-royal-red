#!/bin/bash
# Omarchy Theme Hook for Nodaysidle Royal Red
set -euo pipefail

THEME="${1:-}"

if [[ "$THEME" == "nodaysidle-royal-red" || "$THEME" == "Nodaysidle Royal Red" ]]; then
  CURSOR_BIN="$HOME/.config/omarchy/plugins/taxin.cursor-style/bin/omarchy-cursor-set"
  if [[ -x "$CURSOR_BIN" ]]; then
    "$CURSOR_BIN" "Omarchy-Royal-Red" >/dev/null 2>&1 || true
  else
    hyprctl setcursor "Omarchy-Royal-Red" 24 >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface cursor-theme "Omarchy-Royal-Red" >/dev/null 2>&1 || true
  fi
fi
